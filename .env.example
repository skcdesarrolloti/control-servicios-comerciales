APP_ENV=production
APP_DEBUG=false
APP_SECURE_COOKIES=true
APP_TIMEZONE=America/Bogota
APP_URL=https://example.com/control-servicios-comerciales/public
APP_SECRET=replace-with-at-least-32-random-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wordpress
DB_USERNAME=app_user
DB_PASSWORD=replace-me
DB_PREFIX=wp_
DB_CHARSET=utf8mb4

SETTINGS_FUNCTION_KEY=control_servicios_comerciales_config
DASHBOARD_ADMIN_CARGOS=11,12,13,14
CALENDAR_ALLOWED_CARGOS=9,10,17
CALENDAR_APP_URL=https://calendar-skc.netlify.app
CALENDAR_API_URL=https://sucasainmobiliaria.com.co/calendario-actividades/index.php?action=

TICKET_URL=https://sucasainmobiliaria.com.co/ticket/?id_ticket=
AUTH_ALLOW_LEGACY_PASSWORDS=false

AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_SECRET=
AUTO_LOGIN_TTL=300

SLA_RISK_DAYS=8
SLA_OVERDUE_DAYS=15
DEFAULT_PER_PAGE=24
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES=10
SHARED_NOTIFICATIONS_PATH=
