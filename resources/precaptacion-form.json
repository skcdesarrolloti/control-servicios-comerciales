    "custom_email": "sucasacomercial@gmail.com,gcorrearivera@gmail.com,sc.dircomercial@gmail.com",
    "subject": "Nueva precaptación #%inserted_cct_precaptaciones%",
    "from_name": "SUCASA INMOBILIARIA",
    "from_address": "sucasainfo@sucasainmobiliaria.com.co",
    "content_type": "text/html",
    "content": "<!DOCTYPE html>\n<html lang=\"es\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Precaptación</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f5f5f5; font-family:Arial, sans-serif;\">\n\n  <table align=\"center\" width=\"800\" cellpadding=\"0\" cellspacing=\"0\"\n    style=\"border:3px solid #ebecec; background:#ffffff;\">\n    <tr>\n      <td>\n        <img src=\"%banner%\" alt=\"Banner-skc\" style=\"width:100%; height:auto; display:block;\">\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"padding:20px; text-align:center; color:#061d49;\">\n        <h3 style=\"font-size:16px; margin-bottom:20px;\">Apreciado/a administrador 🤗</h3>\n        <p style=\"font-weight:500; margin:10px 0;\">\n          Nuestro funcionario <b>%creador%</b> ha agregado una nueva precaptación.\n        </p>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"padding:20px; text-align:center; color:#061d49;\">\n        <p style=\"font-weight:500; margin:10px 0;\">\n          A través del siguiente enlace podrás consultar todos los detalles de la precaptación:\n        </p>\n        <a href=\"https://sucasainmobiliaria.com.co/mi-cuenta/precaptacion/?id_precaptacion=%inserted_cct_precaptaciones%\"\n          style=\"background-color:#404041; padding:15px 20px; border-radius:5px; text-decoration:none; color:white; font-weight:700; display:inline-block; margin:15px 0;\">\n          Ver precaptación\n        </a>\n\n        <p style=\"font-weight:500; margin:10px 0;\">\n          ¡Descubre nuestra revista digital! Mantente al día con las mejores oportunidades inmobiliarias, tips\n          exclusivos y tendencias del mercado.\n        </p>\n        <a href=\"https://sucasainmobiliaria.com.co/revista/\"\n          style=\"background-color:#404041; padding:15px 20px; border-radius:5px; text-decoration:none; color:white; font-weight:700; display:inline-block; margin:15px 0;\">\n          Ver revista\n        </a>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"background:#f59120; text-align:center; font-weight:600; font-size:18px; padding:18px; color:white;\">\n        Una empresa para lograr sus sueños.\n      </td>\n    </tr>\n  </table>\n\n</body>\n\n</html>",
